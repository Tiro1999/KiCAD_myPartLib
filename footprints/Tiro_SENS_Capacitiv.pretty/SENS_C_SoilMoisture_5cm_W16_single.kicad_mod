(footprint "SENS_C_SoilMoisture_5cm_W16_single"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Capacitive soil moisture probe, coplanar electrodes, F.Cu only, B.Cu deliberately empty. Board 16 x 79.5 mm, electrode length 50 mm, dry zone 20 mm, insertion depth 59.5 mm below the soil line. Pad 1 = SENSE, pad 2 = GND (both strips). No solder mask or paste apertures - the copper stays under the mask. Board outline is on Dwgs.User, draw Edge.Cuts along it. Simulated 10.9 pF dry / 19.9 pF wet (eps_r 4 / 20, incl. 5 pF circuit parasitics) -> series R approx 15.1 kOhm for a 1.5 MHz 555 front end.")
	(tags "soil moisture capacitive sensor probe coplanar electrode garden plant TLC555 LMC555 FDR")
